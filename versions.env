# =============================================================
# wazamono-toolchain : single source of truth
# 変更したら必ず PKG_REV を進めること（同一 name+version の
# アーカイブ差し替えはインストール済みユーザーに反映されない）
# =============================================================

# ---- avr-gcc toolchain sources ----
GCC_VERSION=15.2.0
GCC_URL=https://ftp.gnu.org/gnu/gcc/gcc-15.2.0/gcc-15.2.0.tar.xz
GCC_SHA256=438fd996826b0c82485a29da03a72d71d6e3541a83ec702df4271f6fe025d24e

BINUTILS_VERSION=2.46.1
BINUTILS_URL=https://ftp.gnu.org/gnu/binutils/binutils-2.46.1.tar.xz
BINUTILS_SHA256=e127a709cba24c76de8936cb7083dd768f28cd37eb010492e2f19b71eb1294e4

# WDT修正(#1068/#1069)は2.3.2未収録。2.3.3/2.4.0リリース時に
# バージョンを上げてPKG_REVを進める。パッチ運用が必要になった場合は
# patches/avr-libc/ に .patch を置き build-avr-gcc.sh が自動適用する。
AVR_LIBC_VERSION=2.3.2
AVR_LIBC_URL=https://github.com/avrdudes/avr-libc/releases/download/avr-libc-2_3_2-release/avr-libc-2.3.2.tar.bz2
AVR_LIBC_SHA256=92eb253d30cec94f2861a82d40d0b17ad79c0d95fce32b74ffccc26a70afb150

# ---- avrdude (公式バイナリの正規化再パッケージ、無改変) ----
AVRDUDE_VERSION=8.1
AVRDUDE_BASE_URL=https://github.com/avrdudes/avrdude/releases/download/v8.1
# 公式アセットのピン留め（上流の黙った差し替えをCIで検知するため）
AVRDUDE_SHA256_WINDOWS_X64=e4d571d81fee3387d51bfdedd0b6565e4c201e974101cac2caec7adfd6201da3
AVRDUDE_SHA256_LINUX_64BIT=c751c88b1c0b886834d85cd4b19f100cc3415c896ab9f98cf7e2955edbcd678f
AVRDUDE_SHA256_LINUX_ARM64=9e1f2c1e7988bac93f30e5e8aea6cd7a9c8e782542f4d93dc04b6495820184d8
AVRDUDE_SHA256_MACOS_64BIT=d7739fbb5d1fe649511121a695dac3f4ca5ccb348919bf1f45f9bc5a2ea0ce72

# ---- packaging ----
PKG_REV=wazamono2
# 合成されるツールバージョン: ${GCC_VERSION}-${PKG_REV} / ${AVRDUDE_VERSION}-${PKG_REV}
